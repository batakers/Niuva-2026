{
  "name": "niuva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "prisma generate && next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pretest:backend": "prisma generate",
    "test:backend": "vitest run --config vitest.backend.config.mts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-db.ps1 start",
    "db:test:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-db.ps1 status",
    "db:test:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-db.ps1 stop",
    "db:test:migrate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-db.ps1 migrate",
    "db:test:seed:public-content": "jiti scripts/seed-approved-public-content.ts",
    "test:integration": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-test-db.ps1 test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1100.0",
    "@aws-sdk/s3-request-presigner": "3.1100.0",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "7.8.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
