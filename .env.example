# Base public URL. Leave blank for local-only UI work; required once a server
# capability needs absolute links or provider callbacks.
APP_URL=

# Neon/PostgreSQL URL. Runtime database access and Prisma migrations fail closed
# when this value is absent or malformed. Use a separate non-production URL below
# for integration tests; never point TEST_DATABASE_URL at production.
DATABASE_URL=
TEST_DATABASE_URL=

# Optional explicit local demo runtime. Keep this unset for ordinary preview or
# production; the demo guard also requires NODE_ENV development/test and a
# loopback database with a dev/demo/test marker in its name.
NIUVA_RUNTIME_MODE=

# Explicit deployment tier and provider mode (env-register.md). Empty tier uses
# the NODE_ENV-derived fail-closed default. These values grant no activation.
NIUVA_DEPLOYMENT_TIER=
NIUVA_PROVIDER_MODE=

# Optional local tooling and preview configuration. Use only test/demo databases.
DEMO_DATABASE_URL=
NIUVA_NEXT_DIST_DIR=
NIUVA_DEV_ALLOWED_ORIGINS=
NIUVA_CUSTOMER_AUTH_MOCK=

# Better Auth for Admin only. Keep the secret private (at least 32 characters).
# URL is the exact application origin; HTTPS is mandatory in production.
# DATABASE_URL and both values are required. Customer sessions remain separate.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# SMTP for Admin verification/password recovery. TLS on 465 or STARTTLS on 587.
# Configure the actual local provider before sending; no Resend fallback.
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=
ADMIN_SMTP_USER=
ADMIN_SMTP_PASSWORD=
ADMIN_EMAIL_FROM=

# Customer Google OAuth. Configure all three values in non-production only;
# never commit credentials or place them in chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Private/public Cloudflare R2 storage. The approved MVP upload ceiling is
# 100 MiB per private customer file.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_ENDPOINT=
# MVP policy: 100 MiB per private customer file.
# Set to 104857600 only after the complete R2 group is configured.
CUSTOM_FILE_MAX_BYTES=
MIDTRANS_IS_PRODUCTION=
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Optional HTTPS Snap endpoint override; an endpoint grants no provider activation.
MIDTRANS_SNAP_ENDPOINT=

# Shipping and email integrations are disabled until their complete capability
# groups are configured. No observability SDK is active in Phase 0.
BITESHIP_API_KEY=
BITESHIP_COURIERS=
BITESHIP_ORIGIN_AREA_ID=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analytics opt-in and scheduled analytics-retention endpoint. Both remain
# disabled unless the corresponding capability and configuration are complete.
NIUVA_ANALYTICS_ENABLED=
CRON_SECRET=
## Owner-only Development auth; disabled unless all guards and both emails pass.
NIUVA_INTERNAL_AUTH_ENABLED=false
NIUVA_INTERNAL_GOOGLE_EMAIL=
NIUVA_INTERNAL_PASSWORD_EMAIL=
