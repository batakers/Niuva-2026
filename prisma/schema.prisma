  submissionKey String @unique @map("submission_key")
  customerId String? @map("customer_id") @db.Uuid
  kind String
  status String @default("OPEN")
  details String?
  correction String?
  contactEmail String? @map("contact_email")
  response String?
  outcome String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  dueAt DateTime @map("due_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  contentDeleteAt DateTime? @map("content_delete_at") @db.Timestamptz(6)
  receiptDeleteAt DateTime? @map("receipt_delete_at") @db.Timestamptz(6)
  contentPurgedAt DateTime? @map("content_purged_at") @db.Timestamptz(6)
  handledBy String? @map("handled_by") @db.Uuid
  holdCategory String? @map("hold_category")
  holdReason String? @map("hold_reason")
  holdOwnerId String? @map("hold_owner_id") @db.Uuid
  holdReviewAt DateTime? @map("hold_review_at") @db.Timestamptz(6)
