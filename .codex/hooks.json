{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel)\" && hook=\"$root/.agents/skills/impeccable/scripts/hook.mjs\" && { [ ! -f \"$hook\" ] || node \"$hook\"; }",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "for /f \"delims=\" %G in ('git rev-parse --show-toplevel') do @if exist \"%G\\.agents\\skills\\impeccable\\scripts\\hook.mjs\" node \"%G\\.agents\\skills\\impeccable\\scripts\\hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel)\" && hook=\"$root/.agents/skills/impeccable/scripts/hook.mjs\" && { [ ! -f \"$hook\" ] || node \"$hook\"; }",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "for /f \"delims=\" %G in ('git rev-parse --show-toplevel') do @if exist \"%G\\.agents\\skills\\impeccable\\scripts\\hook.mjs\" node \"%G\\.agents\\skills\\impeccable\\scripts\\hook.mjs\""
          }
        ]
      }
    ]
  }
}
